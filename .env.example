# Store CTAs (public)
VITE_APP_STORE_URL=https://apps.apple.com/app/kivoo
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=xyz.kivoo.app
VITE_CONTACT_EMAIL=hello@kivoo.org
VITE_CONTACT_API_URL=/api/contact

# Resend (server only — never use VITE_ prefix)
RESEND_API_KEY=re_xxxxxxxx
# After verifying kivoo.org in Resend:
# RESEND_FROM=Kivoo <hello@kivoo.org>
RESEND_FROM=Kivoo <onboarding@resend.dev>
CONTACT_TO=hello@kivoo.org
CONTACT_API_PORT=8787
CONTACT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.kivoo.org,https://kivoo.org
